# OS files
.DS_Store
Thumbs.db

# IDEs and Editors
.idea/
*.iml
*.ipr
*.iws
.vscode/
.project
.classpath
.settings/

# Flutter / Dart / Pub local artifacts (usually handled by client/.gitignore, but good to have)
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies

# We DO want to commit client/pubspec.lock so dependency versions are locked, but ignore temporary build files.
# Build & dependency directories
**/node_modules/
backend/functions/lib/
**/build/
test-results/
playwright-report/

# Firebase emulators, debug logs and local cache
*-debug.log*
.firebase/
.runtimeconfig.json

# Local environment variables
.env
.env*.local

# Node/Package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Additional OS files
Desktop.ini
ehthumbs.db

