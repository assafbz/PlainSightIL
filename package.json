{
  "name": "plainsightil-root",
  "version": "1.0.25",
  "description": "Root workspace management scripts for PlainSightIL",
  "private": true,
  "scripts": {
    "backend:build": "npm run --prefix backend/functions build",
    "backend:start": "PATH=\"/opt/homebrew/opt/openjdk/bin:$PATH\" npx firebase-tools emulators:start --project demo-plainsightil --only firestore,auth,functions",
    "client:start": "flutter run -d chrome --web-port 8080",
    "start": "node scripts/run.js",
    "kill": "node scripts/kill.js",
    "prepare": "bash .agents/bin/install-hooks.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "node scripts/ci-e2e.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
