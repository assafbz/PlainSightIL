#!/bin/bash

# Antigravity SDLC post-checkout hook
# Wipes local processes on switch and runs dependency updates if config files change.


PREV_HEX=$1
NEW_HEX=$2
IS_BRANCH_CHECKOUT=$3

# Ignore file checkout triggers; only execute on branch switches
if [ "$IS_BRANCH_CHECKOUT" -ne 1 ]; then
  exit 0
fi

echo "🔄 [SDLC] Branch switch detected. Running workspace cleanup..."

# 1. Kill any active background processes to avoid port locks
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
PREV_BRANCH=$(git rev-parse --abbrev-ref @{-1} 2>/dev/null)

if [[ $PREV_BRANCH =~ (agents|dev)/([0-9]+)- ]]; then
  PREV_ISSUE_ID=${BASH_REMATCH[2]}
  echo "🧹 [SDLC] Cleaning up processes for previous branch (Issue #$PREV_ISSUE_ID)..."
  PORT_OFFSET=$PREV_ISSUE_ID node scripts/kill.js
fi

if [[ $CURRENT_BRANCH =~ (agents|dev)/([0-9]+)- ]]; then
  CURRENT_ISSUE_ID=${BASH_REMATCH[2]}
  echo "🧹 [SDLC] Cleaning up processes for current branch (Issue #$CURRENT_ISSUE_ID)..."
  PORT_OFFSET=$CURRENT_ISSUE_ID node scripts/kill.js
else
  node scripts/kill.js
fi

# 2. Check if pubspec.yaml changed between branches
if git diff --name-only "$PREV_HEX" "$NEW_HEX" | grep -q 'client/pubspec.yaml'; then
  echo "📦 Dependency change detected in 'client/pubspec.yaml'. Installing packages..."
  (cd client && unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX && flutter pub get)
fi

# 3. Check if package.json in backend/functions changed
if git diff --name-only "$PREV_HEX" "$NEW_HEX" | grep -q 'backend/functions/package.json'; then
  echo "📦 Dependency change detected in 'backend/functions/package.json'. Installing packages..."
  (cd backend/functions && npm install)
fi

exit 0
