{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlainSightIL Firestore Database Schemas",
  "description": "Ground-truth database schema definitions for Cloud Firestore collections, enabling autonomous AI agents to construct correct models and queries.",
  "definitions": {
    "geoPoint": {
      "type": "object",
      "description": "Firestore GeoPoint object representing geographic coordinates.",
      "properties": {
        "_latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "_longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      },
      "required": ["_latitude", "_longitude"]
    },
    "localizedString": {
      "type": "object",
      "description": "Bilingual string containing both Hebrew and English variants.",
      "properties": {
        "he": {
          "type": "string",
          "description": "Hebrew text representation."
        },
        "en": {
          "type": "string",
          "description": "English text representation."
        }
      },
      "required": ["he", "en"]
    }
  },
  "collections": {
    "cellular_antennas": {
      "description": "List of active cellular transmission antennas and radiation measurements.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the antenna (matches doc ID)."
        },
        "antennaId": {
          "type": "string",
          "description": "Operator site or antenna identification code."
        },
        "siteNumber": {
          "type": "string",
          "description": "Official government site registration number."
        },
        "coordinates": {
          "$ref": "#/definitions/geoPoint"
        },
        "geohash": {
          "type": "string",
          "description": "Length 9 geohash calculated from coordinates for spatial range queries."
        },
        "operatorName": {
          "type": "string",
          "description": "Translated English name of the cellular operator."
        },
        "company": {
          "$ref": "#/definitions/localizedString"
        },
        "locality": {
          "type": "string",
          "description": "Hebrew name of the town/locality."
        },
        "permitType": {
          "type": "string",
          "description": "Type of radiation permit issued (e.g. 'Active', 'Permitted')."
        },
        "radiationFrequency": {
          "type": "number",
          "description": "Transmission frequency in MHz."
        },
        "lastTestDate": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of the last periodic radiation safety test."
        },
        "addressHebrew": {
          "type": "string",
          "description": "Full physical address in Hebrew."
        },
        "addressEnglish": {
          "type": "string",
          "description": "Rough translated address in English."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of document ingestion."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of database document modification."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of source metadata last modification."
        }
      },
      "required": [
        "id",
        "antennaId",
        "siteNumber",
        "coordinates",
        "geohash",
        "operatorName",
        "company",
        "locality",
        "permitType",
        "radiationFrequency",
        "lastTestDate",
        "addressHebrew",
        "addressEnglish"
      ]
    },
    "cellular_permit_applications": {
      "description": "Permit applications for cellular towers under construction or review. Follows the blue-green partition system (e.g. permit_apps_blue and permit_apps_green).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document unique identifier (often stringified reference number)."
        },
        "referenceNumber": {
          "type": "integer",
          "description": "Official application reference tracking number."
        },
        "company": {
          "$ref": "#/definitions/localizedString"
        },
        "permitType": {
          "type": "string",
          "description": "Hebrew name of permit stage (e.g., 'היתר הקמה', 'היתר הפעלה')."
        },
        "siteNumber": {
          "type": "string",
          "description": "Cellular site registration identifier."
        },
        "locality": {
          "type": "string",
          "description": "Name of the locality/city in Hebrew."
        },
        "addressDescription": {
          "type": "string",
          "description": "Detailed description of location (e.g. roof, ground-based, street address)."
        },
        "focalPointType": {
          "type": "string",
          "description": "Physical structure type (e.g. 'גג' for roof, 'קרקעי' for ground)."
        },
        "jurisdiction": {
          "type": "string",
          "description": "Local planning authority or jurisdiction."
        },
        "coordinates": {
          "$ref": "#/definitions/geoPoint"
        },
        "geohash": {
          "type": "string",
          "description": "Calculated geohash for proximity indexing."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of document ingestion."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of database document modification."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of source metadata last modification."
        }
      },
      "required": [
        "id",
        "referenceNumber",
        "company",
        "permitType",
        "siteNumber",
        "locality",
        "addressDescription",
        "focalPointType",
        "jurisdiction",
        "coordinates",
        "geohash",
        "lastUpdated"
      ]
    },
    "dataset_metadata": {
      "description": "Coordination meta-records for active scraper sync partitions (Double Buffering metadata).",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Document ID mapping to the dataset name (e.g. 'cellular_permit_applications')."
        },
        "activeCollection": {
          "type": "string",
          "description": "The name of the partition currently active for client queries (e.g., 'permit_apps_blue')."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of the last complete successful ingestion."
        },
        "recordCount": {
          "type": "integer",
          "description": "Total number of documents written to the active partition."
        },
        "status": {
          "type": "string",
          "enum": ["idle", "syncing", "error"],
          "description": "The operational state of the backend sync cron job."
        }
      },
      "required": ["id", "activeCollection", "lastUpdated", "recordCount", "status"]
    },
    "datasets_metadata": {
      "description": "Registry of public datasets available or requested for integration in the Directory screen.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier (often matches data.gov.il resource/package ID)."
        },
        "name": {
          "type": "string",
          "description": "Internal snake_case identifier."
        },
        "title": {
          "type": "string",
          "description": "Hebrew name of the dataset."
        },
        "notes": {
          "type": "string",
          "description": "Description of dataset utility."
        },
        "publisher": {
          "type": "string",
          "description": "Government ministry or agency publishing the dataset."
        },
        "resourceCount": {
          "type": "integer",
          "description": "Number of resource files in the government package."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of data availability."
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Search keyword tags."
        },
        "isSupported": {
          "type": "boolean",
          "description": "True if fully integrated and visualized in the app. False if in the roadmap (voteable)."
        }
      },
      "required": ["id", "name", "title", "notes", "publisher", "resourceCount", "lastUpdated", "tags", "isSupported"]
    },
    "dataset_requests": {
      "description": "Tracks community voting metrics for roadmap dataset activation requests.",
      "type": "object",
      "properties": {
        "datasetId": {
          "type": "string",
          "description": "Target dataset ID (matches doc ID in datasets_metadata)."
        },
        "datasetTitle": {
          "type": "string",
          "description": "Hebrew title of the requested dataset."
        },
        "requestCount": {
          "type": "integer",
          "description": "Total aggregation count of votes cast."
        },
        "lastRequestedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of the most recent vote."
        }
      },
      "required": ["datasetId", "datasetTitle", "requestCount", "lastRequestedAt"],
      "subcollections": {
        "votes": {
          "description": "Identifies users who voted to prevent duplicate voting (one vote per anonymous uid). Doc ID = user UID.",
          "type": "object",
          "properties": {
            "votedAt": {
              "type": "object",
              "description": "Server timestamp representing when the user clicked request."
            }
          },
          "required": ["votedAt"]
        }
      }
    },
    "companies_liquidation": {
      "description": "List of companies in liquidation process, including case status, submission dates, and local jurisdiction info.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the company (matches doc ID and companyId)."
        },
        "companyId": {
          "type": "integer",
          "description": "Official company registration ID number."
        },
        "companyName": {
          "type": "string",
          "description": "Hebrew name of the company."
        },
        "liquidationCaseId": {
          "type": "integer",
          "description": "Unique identifier of the liquidation case."
        },
        "caseStatus": {
          "$ref": "#/definitions/localizedString"
        },
        "submissionDate": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of the liquidation request submission."
        },
        "liquidationOrderDate": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the liquidation order was granted."
        },
        "cancellationFreezeDate": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO timestamp of case cancellation or freeze, or null."
        },
        "closureDate": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO timestamp of case closure, or null."
        },
        "closureReason": {
          "type": ["string", "null"],
          "description": "Reason for case closure in Hebrew, or null."
        },
        "districtCourt": {
          "type": "string",
          "description": "District court managing the case in Hebrew."
        },
        "cityOfActivity": {
          "type": "string",
          "description": "City or locality of company activity in Hebrew."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of the last scraper update."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of document ingestion."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of database document modification."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of source metadata last modification."
        }
      },
      "required": [
        "id",
        "companyId",
        "companyName",
        "liquidationCaseId",
        "caseStatus",
        "submissionDate",
        "liquidationOrderDate",
        "districtCourt",
        "cityOfActivity",
        "createdAt",
        "updatedAt",
        "lastUpdated"
      ]
    },
    "doctors_licenses": {
      "description": "List of doctors holding medical practice licenses in Israel.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the doctor record (matches doc ID)."
        },
        "_id": {
          "type": "integer",
          "description": "Numeric primary key from the government datastore."
        },
        "firstName": {
          "type": "string",
          "description": "First name of the doctor in Hebrew."
        },
        "lastName": {
          "type": "string",
          "description": "Last name of the doctor in Hebrew."
        },
        "licenseNumber": {
          "type": "integer",
          "description": "Official medical license number."
        },
        "licenseRegistrationDate": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when the license was registered."
        },
        "specialtyCertificateNumber": {
          "type": ["integer", "null"],
          "description": "Official medical specialty certificate number, or null."
        },
        "specialtyRegistrationDate": {
          "type": ["string", "null"],
          "format": "date-time",
          "description": "ISO timestamp of specialty registration, or null."
        },
        "specialtyName": {
          "type": ["string", "null"],
          "description": "Name of the medical specialty in Hebrew, or null."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of document ingestion."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of database document modification."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of source metadata last modification."
        }
      },
      "required": [
        "id",
        "_id",
        "firstName",
        "lastName",
        "licenseNumber",
        "licenseRegistrationDate",
        "createdAt",
        "updatedAt",
        "lastUpdated"
      ]
    },
    "local_market_bonds": {
      "description": "List of tradable government bonds issued in the domestic market.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the record (matches doc ID)."
        },
        "_id": {
          "type": "integer",
          "description": "Numeric primary key from the government datastore."
        },
        "issuanceDate": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of bond issuance."
        },
        "bondType": {
          "$ref": "#/definitions/localizedString"
        },
        "series": {
          "type": "integer",
          "description": "Series number of the bond."
        },
        "actualTermToMaturity": {
          "type": "number",
          "description": "Actual term to maturity in years."
        },
        "originalTermToMaturity": {
          "type": "number",
          "description": "Original term to maturity in years."
        },
        "redemptionDate": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of bond redemption."
        },
        "coupon": {
          "type": "number",
          "description": "Coupon rate percentage."
        },
        "offeredQuantity": {
          "type": "number",
          "description": "Offered quantity in millions."
        },
        "purchasedQuantity": {
          "type": "number",
          "description": "Purchased quantity in millions."
        },
        "additionalPurchased": {
          "type": "number",
          "description": "Additional purchased quantity in millions."
        },
        "averagePrice": {
          "type": "number",
          "description": "Average auction price."
        },
        "cutoffPrice": {
          "type": "number",
          "description": "Cutoff auction price."
        },
        "totalFunding": {
          "type": "number",
          "description": "Total funding in millions."
        },
        "demandedAmount": {
          "type": "number",
          "description": "Demanded amount in millions."
        },
        "coverRatio": {
          "type": "number",
          "description": "Auction cover ratio."
        },
        "grossAvgYield": {
          "type": "number",
          "description": "Gross average yield percentage."
        },
        "grossCutoffYield": {
          "type": "number",
          "description": "Gross cutoff yield percentage."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of document ingestion."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of database document modification."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of source metadata last modification."
        }
      },
      "required": [
        "id",
        "_id",
        "issuanceDate",
        "bondType",
        "series",
        "actualTermToMaturity",
        "originalTermToMaturity",
        "redemptionDate",
        "coupon",
        "offeredQuantity",
        "purchasedQuantity",
        "additionalPurchased",
        "averagePrice",
        "cutoffPrice",
        "totalFunding",
        "demandedAmount",
        "coverRatio",
        "grossAvgYield",
        "grossCutoffYield",
        "createdAt",
        "updatedAt",
        "lastUpdated"
      ]
    },
    "subscriptions": {
      "description": "User subscriptions to updates of specific datasets.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the subscription (composite: userId_datasetId)."
        },
        "userId": {
          "type": "string",
          "description": "UID of the subscribing user."
        },
        "datasetId": {
          "type": "string",
          "description": "Identifier of the monitored dataset."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of subscription creation."
        }
      },
      "required": ["id", "userId", "datasetId", "createdAt"]
    },
    "users": {
      "description": "Registered user profile records.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique user identifier matching the Auth UID."
        },
        "firstName": {
          "type": "string",
          "description": "User's first name."
        },
        "lastName": {
          "type": "string",
          "description": "User's last name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "User's email address."
        },
        "role": {
          "type": "string",
          "enum": ["user", "admin"],
          "description": "Security access role."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of user profile creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of last profile update."
        }
      },
      "required": ["uid", "firstName", "lastName", "email", "role", "createdAt", "updatedAt"],
      "subcollections": {
        "alerts": {
          "description": "In-app notifications feed for the user.",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Unique identifier of the alert (matches doc ID)."
            },
            "userId": {
              "type": "string",
              "description": "UID of the target user."
            },
            "type": {
              "type": "string",
              "enum": ["new_dataset", "new_government_dataset", "new_records"],
              "description": "Category of the notification trigger."
            },
            "title": {
              "$ref": "#/definitions/localizedString"
            },
            "description": {
              "$ref": "#/definitions/localizedString"
            },
            "datasetId": {
              "type": ["string", "null"],
              "description": "Identifier of the referenced dataset, if applicable."
            },
            "recordCount": {
              "type": ["integer", "null"],
              "description": "Number of newly ingested records, if applicable."
            },
            "isRead": {
              "type": "boolean",
              "description": "Flag representing whether the user has read the alert."
            },
            "createdAt": {
              "type": "string",
              "format": "date-time",
              "description": "ISO timestamp of alert creation."
            }
          },
          "required": ["id", "userId", "type", "title", "description", "isRead", "createdAt"]
        }
      }
    }
  }
}
