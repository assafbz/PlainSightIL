rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /8935c8e5-ec77-421f-af86-d970583195f8/{document} {
      allow read: if true;
      allow write: if false; // Only written via Cloud Functions Admin SDK
    }
    match /dataset_metadata/{datasetId} {
      allow read: if true;
      allow write: if request.auth != null 
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    match /permit_apps_blue/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /permit_apps_green/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /ff398c7e-c522-4ee8-a53a-312b188a573d/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /d8715392-287f-49b7-9ae3-f21ec5bf55f3/{companyId} {
      allow read: if true;
      allow write: if false;
    }
    match /9c64c522-bbc2-48fe-96fb-3b2a8626f59e/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /21fde05f-62e3-401b-81cf-5c385862026d/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /2a01d234-b2b0-4d46-baa0-cec05c401e7d/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /b2c59e21-c345-4b02-b071-2890a3d431d6/{docId} {
      allow read: if true;
      allow write: if false;
      allow list: if request.query.limit <= 100;
    }
    match /2c33523f-87aa-44ec-a736-edbb0a82975e/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /39f455bf-6db0-4926-859d-017f34eacbcb/{docId} {
      allow read: if true;
      allow write: if false;
    }
    match /c92fdda2-0939-4110-8ebc-edfcf35e8723/{docId} {
      allow read: if true;
      allow write: if false;
      allow list: if request.query.limit <= 100;
    }
    match /datasets_metadata/{document} {
      allow read: if true;
      allow write: if false;
    }
    match /dataset_requests/{datasetId} {
      allow read: if true;
      allow create: if request.auth != null 
                    && request.resource.data.requestCount == 1
                    && request.resource.data.datasetId == datasetId;
      allow update: if request.auth != null 
                    && request.resource.data.requestCount == resource.data.requestCount + 1
                    && request.resource.data.datasetId == resource.data.datasetId;

      match /votes/{userId} {
        allow read: if true;
        allow write, create: if request.auth != null && request.auth.uid == userId;
      }
    }
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.role == "user"
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.firstName is string
                    && request.resource.data.firstName.size() <= 50
                    && request.resource.data.lastName is string
                    && request.resource.data.lastName.size() <= 50
                    && request.resource.data.updatedAt is timestamp
                    && (request.resource.data.isSubscribed == null || request.resource.data.isSubscribed == false)
                    && request.resource.data.keys().hasOnly(['uid', 'firstName', 'lastName', 'email', 'role', 'createdAt', 'updatedAt', 'isSubscribed']);
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.firstName is string
                    && request.resource.data.firstName.size() <= 50
                    && request.resource.data.lastName is string
                    && request.resource.data.lastName.size() <= 50
                    && request.resource.data.updatedAt is timestamp
                    && (request.resource.data.isSubscribed == null || request.resource.data.isSubscribed is bool)
                    && request.resource.data.keys().hasOnly(['uid', 'firstName', 'lastName', 'email', 'role', 'createdAt', 'updatedAt', 'isSubscribed']);
      allow delete: if false; // Deletion is managed by administrative cleanup systems only
 
      match /alerts/{alertId} {
        allow read, update, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if false; // Only written via Cloud Functions Admin SDK
      }
    }
 
    match /subscriptions/{subscriptionId} {
      allow read, write: if request.auth != null && (
        (resource == null && request.resource.data.userId == request.auth.uid) ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if request.auth != null 
                    && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /system_health/{document} {
      allow read: if request.auth != null 
                  && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow write: if false;
    }

    match /scraper_runs/{document} {
      allow read: if request.auth != null 
                  && exists(/databases/$(database)/documents/users/$(request.auth.uid))
                  && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow write: if false;
      allow list: if request.query.limit == null || request.query.limit <= 50;
    }
  }
}
